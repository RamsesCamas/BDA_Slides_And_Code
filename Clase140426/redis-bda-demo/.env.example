# ============================================================
# Variables de entorno para el demo de Redis Cache (BDA)
# Copiar a .env si quieres modificar algún valor.
# Los valores de ejemplo funcionan tal cual para el demo.
# ============================================================

# PostgreSQL
POSTGRES_DB=bda
POSTGRES_USER=bda
POSTGRES_PASSWORD=bda

# Connection URLs (usadas por los backends)
DATABASE_URL=postgresql://bda:bda@postgres:5432/bda
REDIS_URL=redis://redis:6379/0
